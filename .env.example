# Copy this file to .env before running `docker compose up --build`.
# Never commit the real .env file.

# A long, random value. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost

# Ports exposed on the host.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Set to false to skip the idempotent demo seed on container start.
SEED_ON_START=true
